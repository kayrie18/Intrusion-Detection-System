# Custom Suricata rules - CP 81 Project 4 (IDS), Suricata 8.0.8
alert icmp any any -> $HOME_NET any (msg:"LOCAL ICMP ping detected"; itype:8; sid:1000001; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"LOCAL Possible TCP SYN port scan"; flags:S; threshold:type both, track by_src, count 20, seconds 10; sid:1000002; rev:1;)
alert tcp any any -> $HOME_NET 22 (msg:"LOCAL Possible SSH brute force"; flags:S; threshold:type both, track by_src, count 5, seconds 60; sid:1000003; rev:1;)
alert http any any -> $HOME_NET any (msg:"LOCAL Scanner user-agent (sqlmap)"; http.user_agent; content:"sqlmap"; nocase; sid:1000004; rev:1;)
alert http any any -> $HOME_NET any (msg:"LOCAL Directory traversal attempt"; http.uri; content:"../"; sid:1000005; rev:1;)
alert http any any -> $HOME_NET any (msg:"LOCAL SQL injection attempt (UNION SELECT)"; http.uri; content:"union"; nocase; content:"select"; nocase; distance:0; sid:1000006; rev:1;)
